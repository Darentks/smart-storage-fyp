# Put these values in the protected bridge environment, not frontend/Vercel env.
# Local files and restart are required; there is no remote mode-switch endpoint.
SMART_STORAGE_PROCESSOR_MODE=shadow
# Optional; defaults to <repository>/.runtime/edge-models/manifest.json
# SMART_STORAGE_EDGE_MANIFEST=C:/absolute/path/to/manifest.json
# Set explicitly if Node is absent from the managed service account's PATH.
# SMART_STORAGE_NODE=C:/Program Files/nodejs/node.exe
# browser = existing authoritative browser pipeline, native worker disabled
# shadow  = same browser authority, passive native predictions only
# service = gated autonomous coordinator; requires the config and acceptance below
# SMART_STORAGE_EDGE_CONFIG=C:/absolute/path/to/edge-service.config.json
# SMART_STORAGE_EDGE_ACCEPTANCE=C:/absolute/path/to/edge-acceptance.json
# EDGE_CCTV_01_SOURCE=<protected RTSP URL or webcam index>
# EDGE_CCTV_02_SOURCE=<protected RTSP URL or webcam index>
# EDGE_CCTV_03_SOURCE=<protected RTSP URL or webcam index>
