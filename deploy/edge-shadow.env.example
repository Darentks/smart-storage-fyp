# Bridge environment (protected host file such as .env; never frontend/Vercel env, never Git).
#
# NORMAL OPERATION NEEDS NOTHING BELOW. Start the bridge once:
#     python VisionValidation_Module/camera_service.py
# It loads the saved device records, the installed camera-rois.json, the CCTV sources from
# the saved camera records and the staged models, then counts every shelf and watches the
# three CCTVs by itself. The browser is only a dashboard; closing it does not stop anything.
# Setup problems (no calibration installed, missing source, models) are shown in the dashboard.
# The deployment is labelled NOT_FIELD_ACCEPTED until real hardware acceptance exists.

# RAM inventory is the only supported contract.
SMART_STORAGE_INVENTORY_MODE=runtime

# --- optional overrides ---------------------------------------------------------------
# Where camera-rois.json and the bounded local metadata live (default: <repository>/.runtime).
# SMART_STORAGE_DATA_DIR=C:/absolute/path
# ESP32 flash LED brightness (0-255) for every native scan and the quick preview (default 140, the
# dashboard's original first capture round and the TM training setting).
# SMART_STORAGE_CAPTURE_DUTY=140
# Seconds the rack must be free of hand interaction before a count (default 2).
# SMART_STORAGE_QUIET_SECONDS=2
# Staged model manifest (default <repository>/.runtime/edge-models/manifest.json).
# SMART_STORAGE_EDGE_MANIFEST=C:/absolute/path/to/manifest.json
# Set explicitly if Node is absent from the managed service account's PATH.
# SMART_STORAGE_NODE=C:/Program Files/nodejs/node.exe
# Override a CCTV source (otherwise the saved cctv_cameras record is used). Contains credentials.
# EDGE_CCTV_01_SOURCE=<RTSP URL or webcam index>
# EDGE_CCTV_02_SOURCE=<RTSP URL or webcam index>
# EDGE_CCTV_03_SOURCE=<RTSP URL or webcam index>

# --- diagnostics only -------------------------------------------------------------------
# browser = monitoring only, native worker disabled; shadow = passive native predictions.
# Neither can change inventory. Default is service (the shared native processor).
# SMART_STORAGE_PROCESSOR_MODE=service

# --- release evidence (optional, never required to run) ---------------------------------
# A fully verified record only upgrades the label to ACCEPTED. A missing, expired or
# mismatched record is reported and ignored. Produce one with deploy/prepare_edge_acceptance.py
# and fill it in only from real hardware tests.
# SMART_STORAGE_EDGE_ACCEPTANCE=C:/absolute/path/to/edge-acceptance.json
# Legacy explicit config file (calibration_file + source_environment); not needed normally.
# SMART_STORAGE_EDGE_CONFIG=C:/absolute/path/to/edge-service.config.json
