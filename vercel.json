{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/models/:path*",
      "destination": "/models/:path*"
    },
    {
      "source": "/((?!models/|src/|VisionValidation_Module/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.onnx",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
